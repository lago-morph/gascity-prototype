# Gas City prototype — environment for docker compose.
# Copy to .env and adjust for your environment.

# === Auth ===
# Laptop: provide your Anthropic API key here.
# Sandbox: leave empty; CLAUDE_CODE_OAUTH_TOKEN + ANTHROPIC_BASE_URL come from
#          the sandbox env via docker-compose.sandbox.yml.
ANTHROPIC_API_KEY=

# === Repo URLs ===
# Laptop defaults — change to your fork if you're not lago-morph.
RIG1_URL=https://github.com/lago-morph/gascity-proto-rig1.git
RIG2_URL=https://github.com/lago-morph/gascity-proto-rig2.git
BEADSTORE_URL=https://github.com/lago-morph/gascity-proto-beadstore.git

# === Branches ===
# Override per-repo if you're tracking something other than main.
RIG1_BRANCH=main
RIG2_BRANCH=main
BEADSTORE_BRANCH=main

# === Dolt git-remote ref ===
# Dolt's default ref (refs/dolt/data) is blocked by the sandbox's git proxy;
# we use a regular branch ref so both sandbox and laptop behave identically.
DOLT_REF=refs/heads/dolt-data
